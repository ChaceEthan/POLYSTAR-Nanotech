# POLYSTAR Nanotech Ltd
# Copy to .env for local development. Keep real production secrets in Render/Vercel dashboards.

# =========================================
# Backend application
# =========================================
APP_NAME=POLYSTAR Platform
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Public website/client origins. CORS_ORIGIN may contain a comma-separated list.
APP_URL=https://www.polystar.rw
FRONTEND_URL=https://www.polystar.rw
CLIENT_URL=https://www.polystar.rw
CORS_ORIGIN=https://www.polystar.rw,http://localhost:3000

# Optional backend API origin. The frontend uses NEXT_PUBLIC_API_URL below.
API_URL=http://localhost:5000

# =========================================
# Company defaults
# =========================================
COMPANY_NAME=POLYSTAR Nanotech Ltd
COMPANY_PHONE=+250781990307
COMPANY_EMAIL=info@polystar.rw
COMPANY_LOCATION=Kigali,Rwanda
MANAGING_DIRECTOR=Eng. Amani Niyoyita
ADMIN_EMAIL=amanipolystar@gmail.com

# =========================================
# Database and authentication
# Required in Render for full production functionality.
# =========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/polystar_platform?retryWrites=true&w=majority
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_ACCESS_SECRET=replace_with_at_least_24_random_characters
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_24_character_secret
JWT_REFRESH_EXPIRES_IN=30d

# =========================================
# Email notifications
# SMTP_PASS is required for actual email delivery. Without it, submissions are stored and email is logged as unconfigured.
# =========================================
MAIL_FROM=info@polystar.rw
ADMIN_NOTIFICATION_EMAIL=amanipolystar@gmail.com
CAREERS_EMAIL=careers@polystar.rw
SMTP_HOST=mail.polystar.rw
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@polystar.rw
SMTP_PASS=

# =========================================
# Media upload
# Required only when authenticated Cloudinary uploads are enabled.
# =========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================================
# Frontend public environment
# Set these in the frontend hosting project.
# =========================================
NEXT_PUBLIC_SITE_URL=https://www.polystar.rw
NEXT_PUBLIC_API_URL=https://polystar-nanotech.onrender.com/api/v1
NEXT_PUBLIC_COMPANY_PHONE=+250781990307
NEXT_PUBLIC_COMPANY_EMAIL=info@polystar.rw
NEXT_PUBLIC_COMPANY_LOCATION=Kigali,Rwanda
NEXT_PUBLIC_QR_COMPANY_PROFILE_URL=https://www.polystar.rw/company-profile
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Search Console verification is consumed by frontend metadata.
GOOGLE_SEARCH_CONSOLE_VERIFICATION=

# =========================================
# QR profile
# =========================================
QR_COMPANY_PROFILE_URL=https://www.polystar.rw/company-profile

# =========================================
# Admin seed users
# Use only for controlled setup/seed operations.
# =========================================
ADMIN_SEED_NAME=Eng. Amani Niyoyita
ADMIN_SEED_EMAIL=amanipolystar@gmail.com
ADMIN_SEED_PASSWORD=ChangeMe123!
OWNER_SEED_NAME=
OWNER_SEED_EMAIL=
OWNER_SEED_PASSWORD=
PARTNER_SEED_NAME=
PARTNER_SEED_EMAIL=
PARTNER_SEED_PASSWORD=
