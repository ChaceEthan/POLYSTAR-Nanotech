{
  "name": "polystar-platform",
  "version": "1.0.0",
  "private": true,
  "description": "POLYSTAR Platform monorepo for POLYSTAR Nanotech Ltd, Kigali, Rwanda.",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -n backend,frontend -c blue,cyan \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace shared && npm run build --workspace backend && npm run build --workspace frontend",
    "start": "node node_modules/concurrently/dist/bin/concurrently.js -n backend,frontend -c blue,cyan \"npm run start --workspace backend\" \"npm run start --workspace frontend\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "tree": "node scripts/print-tree.mjs"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.10.0",
    "@eslint-community/eslint-utils": "^4.9.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "levn": "^0.4.1",
    "side-channel-list": "^1.0.1",
    "side-channel-map": "^1.0.1",
    "side-channel-weakmap": "^1.0.2"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@colors/colors": "1.6.0",
    "@dabh/diagnostics": "2.0.8",
    "@standard-schema/utils": "0.3.0",
    "@types/webidl-conversions": "7.0.3",
    "async": "3.2.6",
    "basic-auth": "2.0.1",
    "compressible": "2.0.18",
    "ee-first": "1.1.1",
    "forwarded": "0.2.0",
    "ipaddr.js": "1.9.1",
    "is-promise": "4.0.0",
    "is-stream": "2.0.1",
    "lodash.isinteger": "4.0.4",
    "lodash.isstring": "4.0.1",
    "logform": "2.7.0",
    "memory-pager": "1.5.0",
    "one-time": "1.0.0",
    "path-to-regexp": "8.4.2",
    "safe-stable-stringify": "2.5.0",
    "stack-trace": "0.0.10",
    "triple-beam": "1.4.1",
    "undici-types": "7.16.0",
    "unpipe": "1.0.0",
    "whatwg-url": "14.2.0",
    "winston-transport": "4.9.0",
    "wrappy": "1.0.2"
  }
}
